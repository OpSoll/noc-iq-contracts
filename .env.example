# NOC IQ Contracts — Environment Configuration
# Copy this file to .env and fill in your values for local development.
# .env is gitignored and should NEVER be committed.
#
# These variables are used by the TypeScript off-chain tooling (scripts/, offchain/, ts/).
# The Rust contract itself does not read environment variables at runtime.

# ---------------------------------------------------------------------------
# Stellar Network
# ---------------------------------------------------------------------------
# Target network for deployment and integration scripts.
# Options: testnet | futurenet | mainnet | standalone
STELLAR_NETWORK=testnet

# Stellar Horizon REST API endpoint
STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org

# Soroban RPC endpoint for contract simulation and invocation
STELLAR_SOROBAN_RPC_URL=https://soroban-testnet.stellar.org

# ---------------------------------------------------------------------------
# Contract Addresses (populated after deployment)
# ---------------------------------------------------------------------------
# Contract ID of the deployed sla_calculator contract.
# Set after running scripts/deploy.ts
SLA_CONTRACT_ID=

# ---------------------------------------------------------------------------
# Deployment Keys (NEVER commit real secret keys)
# ---------------------------------------------------------------------------
# Stellar public key (G...) for the admin account
ADMIN_PUBLIC_KEY=

# CRITICAL: Secret key must be injected via environment only — never store in files
# ADMIN_SECRET_KEY=INJECT_VIA_ENVIRONMENT_OR_SECRETS_MANAGER

# Stellar public key (G...) for the operator account
OPERATOR_PUBLIC_KEY=

# ---------------------------------------------------------------------------
# SLA Calculator Initial Configuration
# ---------------------------------------------------------------------------
THRESHOLD_MINUTES=60
PENALTY_PER_MINUTE=100
REWARD_BASE=500
